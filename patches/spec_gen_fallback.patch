+    def _lcn_set_plain_decode_input_ids(self):
+        """Materialize input_ids for a spec->plain decode fallback.
+
+        The plain path normally gets input_ids from the previous run_batch, or
+        (under overlap) from FutureMap.output_tokens_buf at forward entry. With
+        NGRAM configured, BOTH sources are empty: FutureMap.stash() early-returns
+        for ngram, so output_tokens_buf is never written, and resolve_forward_inputs
+        gates its gather on future_map.spec_algo.is_none(). So the last real token
+        has to be rebuilt here.
+
+        Reconstruction mirrors NGRAMWorker._prepare_draft_tokens exactly: the true
+        history is origin_input_ids + output_ids + the previous round's accepted
+        tokens, and under overlap that last group has NOT yet landed in
+        req.output_ids (results are processed one iteration behind). accept_tokens
+        is laid out per request at stride draft_token_num, valid for accept_lens[i]
+        entries -- so the newest token is the last valid entry when there is one.
+        """
+        spec_info = self.spec_info
+        prev_tokens = prev_lens = None
+        stride = 0
+        if (
+            self.enable_overlap
+            and spec_info is not None
+            and getattr(spec_info, "accept_tokens", None) is not None
+            and getattr(spec_info, "accept_lens", None) is not None
+        ):
+            # Host sync: acceptable here because a generating batch is already
+            # eager and host-driven (the state machines run per token).
+            prev_tokens = spec_info.accept_tokens.tolist()
+            prev_lens = spec_info.accept_lens.tolist()
+            stride = spec_info.draft_token_num
+
+        last_tokens = []
+        for i, req in enumerate(self.reqs):
+            tok = None
+            if prev_tokens is not None and i < len(prev_lens) and prev_lens[i] > 0:
+                idx = i * stride + prev_lens[i] - 1
+                if idx < len(prev_tokens):
+                    tok = prev_tokens[idx]
+            if tok is None:
+                tok = (
+                    req.output_ids[-1]
+                    if len(req.output_ids)
+                    else req.origin_input_ids[-1]
+                )
+            last_tokens.append(tok)
+
+        self.input_ids = torch.tensor(
+            last_tokens,
+            dtype=torch.int64,
+            pin_memory=is_pin_memory_available(self.device),
+        ).to(self.device, non_blocking=True)
+
